# =====================================================================
# RAG QA System 环境变量模板
# 复制本文件为 .env 后填入真实值：
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
#
# 说明：
# - 所有配置项均有默认值，本文件只列出可覆盖项，缺失时不影响启动；
# - 不填密钥则以「降级演示模式」运行（伪向量 + 无 LLM 回答），
#   全流程仍可跑通，但检索与回答质量均不可用于生产；
# - 密钥只写在 .env（已被 .gitignore 忽略），切勿提交到代码库。
# =====================================================================

# ---------------------------------------------------------------------
# 路径配置（一般保持默认即可）
# ---------------------------------------------------------------------
CHROMA_DB_PATH=./db/chroma_db
SQLITE_DB_PATH=./db/rag.db
LOG_FILE=./logs/rag.log
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------
# RAG 超参数
# ---------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=3
MAX_RETRY=2
TEMPERATURE=0.1
MAX_TOKENS=1000

# ---------------------------------------------------------------------
# 混合检索（向量稠密 + BM25 稀疏，RRF 融合）
# ---------------------------------------------------------------------
ENABLE_HYBRID_SEARCH=1
BM25_CANDIDATE_K=5
RRF_K=60

# ---------------------------------------------------------------------
# 模型配置
# LLM / Embedding / Rerank 均通过 OpenAI 兼容协议调用，填写各平台对应的模型标识。
# 示例值为常见开源模型，请按所选平台实际提供的模型名替换。
# ---------------------------------------------------------------------
# 对话（生成）模型标识
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 向量（Embedding）模型标识，维度变化会自动重建向量集合
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
# 重排（Rerank）模型标识
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Multi-Query 生成的子查询数量
MULTI_QUERY_NUM=3

# 重排降级链：本地 CrossEncoder 优先 → 云端 /rerank 接口 → 保持召回原顺序。
# 本地已缓存某重排模型时，把 RERANKER_MODEL_NAME 改成它，并开启下方离线模式，
# 可彻底避免联网下载；未缓存时保持默认值、不要开启离线模式。
# HF_HUB_OFFLINE=1

# ---------------------------------------------------------------------
# API 密钥与接入地址
# LLM 与 Embedding 共用同一个 OpenAI 兼容接入点，两个 key 通常填同一个值。
# 更换平台只需改下面两项与上方的模型标识，代码无需改动。
# ---------------------------------------------------------------------
OPENAI_API_BASE=<你的 OpenAI 兼容接入点，形如 https://<host>/v1>
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------
# 功能开关
# ---------------------------------------------------------------------
ENABLE_MULTI_QUERY=1
ENABLE_RERANKER=1
